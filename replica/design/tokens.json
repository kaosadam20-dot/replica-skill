    "text": "#F4F2EE",
    "text-muted": "#9C9A95",
    "text-dim": "#817F7A",
    "accent": "#E7B44C",
    "accent-soft": "#332A16",
    "on-accent": "#191307",
    "danger": "#E4736B",
    "success": "#86BE8F"
  },
  "pairs": [
